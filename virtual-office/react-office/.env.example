# Origin of your n8n instance (used by the dev proxy)
N8N_ORIGIN=https://q8kwt.app.n8n.cloud

# Base path the app calls. In dev keep /n8n/webhook (goes through the proxy).
# For a production build, set the full URL, e.g. https://q8kwt.app.n8n.cloud/webhook
# To test unpublished workflows, use /n8n/webhook-test (each test URL only works once per "Listen" click).
VITE_N8N_BASE=/n8n/webhook

# How often the office polls GET /qd-company-state (ms)
VITE_POLL_MS=10000
